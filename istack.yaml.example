# istack.yaml — one per repo. Validate with: npx istack config check
version: 1

# The human who holds both gates: says yes to the ticket, and is the only one who merges.
owner: Sam Rivera

# solo    — one reviewer, no council. Lightest path; good for a typo.
# team    — cross-provider reviewer on every PR.
# factory — team + a scored council on visible changes and one-way doors.
profile: team

# The repo's own checks. Every PR must pass all of them before it is ready.
checks:
  - name: test
    run: npm test
  - name: typecheck
    run: npm run typecheck
  - name: whitespace
    run: git diff --check

# Files whose change a person can see. Changing any of these requires a before/after pair.
visibleChange:
  include:
    - "src/**/*.{tsx,css}"
    - "public/**"
  exclude:
    - "**/*.test.tsx"

# Shared resources a worktree does not isolate. Agents ask the owner before touching these.
ownershipGates:
  - resource: shared local database
    owner: Sam Rivera
    rule: never wipe or migrate it; use a per-worktree schema
  - resource: production deploys
    owner: Sam Rivera
    rule: agents never deploy

# Council: several AI providers score before/after pictures (team and factory only).
council:
  enabled: false
  budgetUsdPerPr: 10

# Per-worktree environment for `istack env up`. Every worktree leases its own ports from the
# range (recorded in the repo's shared git dir, so two worktrees never collide; `env down` frees
# them). Ports named in ownershipGates ("port 5432") are never handed out.
env:
  ports:
    from: 4100
    to: 4999
    names: [web, api]
  # Copied from the main checkout when the worktree lacks them; listed keys get this worktree's
  # ports. Values are never printed.
  files:
    - path: .env.local
      set:
        PORT: web
        API_URL: "http://127.0.0.1:{{api}}"
  # Optional. Runs only with `env up --db`; refused in the main checkout and for any create
  # command that wipes or migrates. {{worktree}} renders as the worktree directory name plus an
  # 8-char hash of its real path (e.g. myapp_task_1a2b3c4d), so same-named worktrees never share.
  # database:
  #   name: "{{repo}}_{{worktree}}"
  #   create: "createdb {{name}}"
  #   drop: "dropdb {{name}}"
