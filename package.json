{
  "name": "mitchstack",
  "version": "0.0.0",
  "description": "Receipts, not vibes. An agent workflow where every PR carries checked proof.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mitchstack": "dist/bin/mitchstack.js"
  },
  "files": [
    "dist",
    "skills",
    "schema",
    "templates",
    "hooks",
    ".claude-plugin",
    "AGENTS.md",
    "LICENSE",
    "CREDITS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "schema": "tsc -p tsconfig.build.json && node scripts/write-schemas.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "playwright": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
