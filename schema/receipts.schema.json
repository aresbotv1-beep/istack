{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "the PR head commit these receipts were produced against"
    },
    "door": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "one-way",
            "two-way"
          ]
        },
        "blastRadius": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "blastRadius"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "visual"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "surface": {
                "type": "string",
                "minLength": 1,
                "description": "the URL or screen the pictures were taken on"
              },
              "before": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "absent"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      }
                    },
                    "required": [
                      "sha256",
                      "url"
                    ],
                    "additionalProperties": false
                  }
                ],
                "description": "'absent' only for a brand-new screen"
              },
              "after": {
                "type": "object",
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "sha256",
                  "url"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "statement",
              "surface",
              "before",
              "after"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "red-green"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "red": {
                "type": "object",
                "properties": {
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{7,40}$"
                  },
                  "exitCode": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "sha",
                  "exitCode"
                ],
                "additionalProperties": false
              },
              "green": {
                "type": "object",
                "properties": {
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{7,40}$"
                  },
                  "exitCode": {
                    "type": "number",
                    "const": 0
                  }
                },
                "required": [
                  "sha",
                  "exitCode"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "statement",
              "command",
              "red",
              "green"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "output"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "type": "string"
              },
              "after": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "statement",
              "command",
              "before",
              "after"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "noVisibleChange": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "head",
    "door",
    "claims"
  ],
  "additionalProperties": false
}
