{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "the human who holds both gates"
    },
    "profile": {
      "type": "string",
      "enum": [
        "solo",
        "team",
        "factory"
      ]
    },
    "checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "run": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "run"
        ],
        "additionalProperties": false
      }
    },
    "visibleChange": {
      "default": {
        "include": [
          "**/*.{tsx,jsx,vue,svelte,astro,html,css,scss}",
          "**/templates/**",
          "public/**"
        ],
        "exclude": []
      },
      "type": "object",
      "properties": {
        "include": {
          "default": [
            "**/*.{tsx,jsx,vue,svelte,astro,html,css,scss}",
            "**/templates/**",
            "public/**"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "ownershipGates": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1,
            "description": "e.g. 'port 3200', 'shared local database', 'production deploy'"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "description": "what an agent must do: usually 'ask the owner first'"
          }
        },
        "required": [
          "resource",
          "owner",
          "rule"
        ],
        "additionalProperties": false
      }
    },
    "council": {
      "default": {
        "enabled": false,
        "budgetUsdPerPr": 10,
        "providers": []
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "budgetUsdPerPr": {
          "default": 10,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "providers": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "owner",
    "profile",
    "checks"
  ],
  "additionalProperties": false
}
